generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String
  role              String    @default("MEMBER") // ADMIN or MEMBER
  avatar            String?
  status            String    @default("active")
  bio               String?
  assignedProjectId String?
  assignedProject   Project?  @relation("ProjectMembers", fields: [assignedProjectId], references: [id])
  
  tasks             TaskAssignment[]
  sentMessages      Message[] @relation("SentMessages")
  notifications     Notification[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String?
  startDate       DateTime?
  deadline        DateTime?
  status          String    @default("Planning")
  progress        Int       @default(0)
  color           String    @default("#5B6BF9")
  
  // Resource links
  specifications  String?
  assetsFolder    String?
  productionLink  String?
  
  tasks           Task[]
  members         User[]    @relation("ProjectMembers")
  activityLogs    ActivityLog[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  name        String
  description String?
  urgency     String    @default("Medium") // Low, Medium, High, Critical
  status      String    @default("To Do") // To Do, In Progress, In Review, Done
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  dueDate     DateTime?
  assignees   TaskAssignment[]
  notifications Notification[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TaskAssignment {
  userId String
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("task")
  read      Boolean  @default(false)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  text           String
  senderId       String
  sender         User     @relation("SentMessages", fields: [senderId], references: [id])
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName   String
  action     String
  targetName String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  timestamp  DateTime @default(now())
}
